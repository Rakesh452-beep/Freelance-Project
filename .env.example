# Supabase — https://supabase.com/dashboard (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail sending — your Gmail address + an App Password.
# Create the app password at https://myaccount.google.com/apppasswords
# (needs Google 2-Step Verification ON). Use it below — it looks like
# "abcd efgh ijkl mnop" (spaces removed).
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=

# Resend fallback (optional) — https://resend.com (Dashboard → API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public site URL — used in email links (admin + review). Set in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time migration helper — guards POST /api/admin/confirm-email (server-side only).
# Generate a random value, e.g. `openssl rand -hex 32`. NEVER prefix with NEXT_PUBLIC_.
ADMIN_CONFIRM_SECRET=

# Admin account email — receives booking/inquiry alerts (server-side only).
ADMIN_EMAIL=yourname@gmail.com

# UPI payment details — shown on booking pages for QR payments.
NEXT_PUBLIC_UPI_ID=yournumber@ybl
NEXT_PUBLIC_UPI_NAME=Your Name
